# Hardcover - create a read-only token at hardcover.app → Settings → Hardcover API
HARDCOVER_TOKEN=

# Spotify - https://developer.spotify.com/dashboard
# Redirect URI for the one-time auth: http://127.0.0.1:8888/callback
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=
# Written automatically by `npm run spotify-auth`
SPOTIFY_REFRESH_TOKEN=

# The SPOTIFY_* values and HARDCOVER_TOKEN must ALSO be set as Pages
# environment variables (Cloudflare dashboard → Workers & Pages → your project
# → Settings → Environment variables) so /api/now and /api/reading can read
# them. For local `npm run preview` (wrangler pages dev), copy them into
# .dev.vars instead.

# Cloudflare Web Analytics - powers the per-post view counts (/api/views).
# Enable Web Analytics on the Pages project, then:
#   CF_ANALYTICS_TOKEN    API token with Account → Analytics → Read
#   CF_ACCOUNT_ID         the account id (dashboard URL / sidebar)
#   CF_WEB_ANALYTICS_TAG  the site tag from the beacon snippet (32 hex chars)
CF_ANALYTICS_TOKEN=
CF_ACCOUNT_ID=
CF_WEB_ANALYTICS_TAG=
