---
interface Props {
    title?: string;
    description?: string;
    ogImage?: string;
}

const {
    title = "eulerbutcooler",
    description = "Full-stack developer building things at the edge of the web.",
    ogImage,
} = Astro.props;
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <link rel="icon" type="image/svg+xml" href="/icon.svg" />
        <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
        <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
        <meta name="generator" content={Astro.generator} />
        <meta name="description" content={description} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:type" content="website" />
        {ogImage && <meta property="og:image" content={ogImage} />}
        {ogImage && <meta property="og:image:width" content="1200" />}
        {ogImage && <meta property="og:image:height" content="630" />}
        <meta
            name="twitter:card"
            content={ogImage ? "summary_large_image" : "summary"}
        />
        {ogImage && <meta name="twitter:image" content={ogImage} />}
        <title>{title}</title>
        <meta name="theme-color" content="#08090c" />
        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        <link
            href="https://fonts.googleapis.com/css2?family=Doto:ROND,wght@0,100..900;1,100..900&family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans:ital,wght@0,400;0,500;0,600;1,400&display=swap"
            rel="stylesheet"
        />
    </head>
    <body>
        <a class="skip-link" href="#main">Skip to content</a>
        <slot />
    </body>
</html>

<style is:global>
    :root {
        /* Ink */
        --blue: #f4f5f7;
        --blue-mid: rgba(244, 245, 247, 0.82);
        --blue-dim: rgba(244, 245, 247, 0.62);
        --blue-subtle: rgba(255, 255, 255, 0.06);
        --hero-ink: #ffb74d;
        --accent-orange: #ffb74d;
        --accent-teal: #4db6ac;
        --accent-blue: #8b9bff;
        /* Ground */
        --bg: #08090c;
        --border: rgba(255, 255, 255, 0.12);
        --rule: rgba(244, 245, 247, 0.26);
        /* Code panels */
        --code-bg: #12141a;
        --code-border: rgba(255, 255, 255, 0.08);
        /* Motion */
        --ease-out: cubic-bezier(0.23, 1, 0.32, 1);
        --ease-in-out: cubic-bezier(0.77, 0, 0.175, 1);
        --font-mono: "IBM Plex Mono", "Courier New", monospace;
        --font-doto: "Doto", monospace;
        --font-sans: "IBM Plex Sans", sans-serif;
        --max-w: 900px;
        color-scheme: dark;
    }

    *,
    *::before,
    *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
    }

    html {
        font-size: 15.3px;
        scrollbar-gutter: stable;
        -webkit-font-smoothing: antialiased;
        background-color: var(--bg);
    }

    body {
        color: var(--blue);
        font-family: var(--font-sans);
        min-height: 100vh;
        display: flex;
        flex-direction: column;
    }

    /* Sticky footer: main absorbs the slack, the footer sits at the page floor */
    #site-wrap {
        flex: 1 0 auto;
        width: 100%;
        display: flex;
        flex-direction: column;
    }

    #main {
        flex: 1 0 auto;
    }

    ::selection {
        background: var(--blue-mid);
        color: var(--bg);
    }

    a {
        color: inherit;
        text-decoration: none;
    }

    button {
        touch-action: manipulation;
    }

    :focus-visible {
        outline: 1.8px solid var(--blue);
        outline-offset: 2.7px;
    }

    h1,
    h2,
    h3 {
        text-wrap: balance;
    }

    @media (prefers-reduced-motion: no-preference) {
        html {
            scroll-behavior: smooth;
        }
    }

    p {
        text-wrap: pretty;
    }

    img {
        max-width: 100%;
        height: auto;
    }

    .skip-link {
        position: absolute;
        top: -43.2px;
        left: 14.4px;
        z-index: 100;
        padding: 7.2px 12.6px;
        background: var(--blue);
        color: var(--bg);
        font-family: var(--font-mono);
        font-size: 11.7px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        transition: top 180ms var(--ease-out);
    }

    .skip-link:focus-visible {
        top: 10.8px;
        outline-offset: 0;
    }
</style>
