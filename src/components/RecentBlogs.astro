---
import { getCollection } from "astro:content";

const allPosts = await getCollection("blog", ({ data }) => data.draft !== true);
const posts = allPosts
  .sort((a, b) => new Date(b.data.date).getTime() - new Date(a.data.date).getTime())
  .slice(0, 3);
---

<section id="blogs">
  <div id="blogs-inner">
    <span class="section-label">[Writing]</span>

    <div id="blogs-list">
      {posts.map((post) => (
        <a href={`/blog/${post.id}`} class="blog-row">
          <span class="blog-tag">[{post.data.tag}]</span>
          <span class="blog-title">{post.data.title}</span>
          <span class="blog-meta">
            <span class="blog-date">{post.data.date.slice(0, 7)}</span>
            <span class="blog-arrow">→</span>
          </span>
        </a>
      ))}

      <a href="/blogs" class="blog-row blog-row--all">
        <span class="blog-all">All posts →</span>
      </a>
    </div>
  </div>
</section>

<style>
  #blogs {
    border-bottom: 1px dotted var(--rule);
  }

  #blogs-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 34.2px 0;
    display: grid;
    grid-template-columns: 99px 1fr;
    gap: 0 21.6px;
    align-items: start;
  }

  .section-label {
    font-size: 12.6px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-dim);
    padding-top: 12.6px;
  }

  #blogs-list {
    display: flex;
    flex-direction: column;
  }

  .blog-row {
    display: grid;
    grid-template-columns: 117px 1fr auto;
    gap: 0 14.4px;
    align-items: center;
    padding: 13.5px 18px;
    border-bottom: 1px dotted var(--rule);
    text-decoration: none;
    color: var(--blue);
    transition: background-color 140ms var(--ease-out);
  }

  .blog-row:last-child {
    border-bottom: none;
  }

  .blog-row:first-child {
    border-top: 1px dotted var(--rule);
  }

  .blog-row:hover {
    background: var(--blue-subtle);
  }

  .blog-row:active {
    background: var(--border);
  }

  .blog-tag {
    font-family: var(--font-mono);
    font-size: 11.7px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-dim);
    white-space: nowrap;
  }

  .blog-title {
    font-size: 13.5px;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--blue);
  }

  .blog-all {
    font-family: var(--font-mono);
    font-size: 11.7px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-dim);
  }

  .blog-row--all:hover .blog-all {
    color: var(--blue);
  }

  .blog-meta {
    display: flex;
    align-items: center;
    gap: 9px;
    flex-shrink: 0;
  }

  .blog-date {
    font-size: 12.6px;
    letter-spacing: 0.08em;
    color: var(--blue-dim);
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .blog-arrow {
    font-size: 13.5px;
    color: var(--blue-dim);
    transition:
      transform 200ms var(--ease-out),
      color 160ms var(--ease-out);
  }

  .blog-row:hover .blog-arrow {
    transform: translateX(2.7px);
    color: var(--blue);
  }

  @media (max-width: 576px) {
    #blogs-inner {
      grid-template-columns: 1fr;
      gap: 14.4px;
    }

    .section-label { padding-top: 0; }

    .blog-row {
      grid-template-columns: 1fr auto;
    }

    .blog-tag { display: none; }
  }
</style>
