---
import { reading, listening } from "../data/now";

// Short labels for the now-line: drop subtitles after a colon / dash and cap
// the length; the full title lives in the tooltip.
const shorten = (s: string) =>
    s.length > 34 ? s.slice(0, 33).trimEnd() + "…" : s;
const bookShort = reading
    ? shorten(reading.title.split(/\s*:\s*/)[0].trim())
    : null;
const listenShort = listening
    ? shorten(listening.track.split(/\s+[\u2014\u2013]\s+/)[0].trim())
    : null;
const hasNow = Boolean(reading || listening);
---

<section id="about">
    <div id="about-inner">
        <span class="section-label">[About]</span>

        <div id="about-body">
            <p id="about-bio">
                I love learning and building systems that do well at all scales.
                I contribute to OSS and I have a knack for networks and
                databases.
                <br />
                Fulltime internet resident. You can find me on
                <a
                    class="social"
                    href="https://x.com/elrbtclr"
                    target="_blank"
                    rel="noopener"
                    title="X"
                >
                    <svg
                        class="social-icon social-icon--x"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"></path>
                    </svg>
                </a>
                and
                <a
                    class="social"
                    href="https://discord.com/users/eulerbutcooler"
                    target="_blank"
                    rel="noopener"
                    title="Discord"
                >
                    <svg
                        class="social-icon social-icon--discord"
                        viewBox="0 0 24 24"
                        aria-hidden="true"
                    >
                        <path d="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z"></path>
                    </svg>
                </a>
            </p>

            {hasNow && (
                <div id="now-line">
                    {listening && listenShort && (
                        <a
                            id="now-link"
                            href={listening.url ?? undefined}
                            target="_blank"
                            rel="noopener"
                            title={`${listening.track} - ${listening.artist}`}
                        >
                            <svg
                                class="now-icon now-icon--vinyl"
                                viewBox="0 0 16 16"
                                aria-hidden="true"
                            >
                                <circle
                                    cx="8"
                                    cy="8"
                                    r="6.4"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.4"
                                />
                                <g class="vinyl-groove">
                                    <circle
                                        cx="8"
                                        cy="8"
                                        r="3.6"
                                        fill="none"
                                        stroke="currentColor"
                                        stroke-width="1.2"
                                        stroke-dasharray="2.6 3.6"
                                        stroke-linecap="round"
                                    />
                                </g>
                                <circle
                                    cx="8"
                                    cy="8"
                                    r="1.1"
                                    fill="currentColor"
                                />
                            </svg>
                            <span class="now-title" id="now-title">
                                {listenShort}
                            </span>
                        </a>
                    )}

                    {reading && bookShort && (
                        <a
                            id="now-book-link"
                            href={reading.url}
                            target="_blank"
                            rel="noopener"
                            title={`${reading.title} - ${reading.author}`}
                        >
                            <svg
                                class="now-icon now-icon--book"
                                viewBox="0 0 16 16"
                                aria-hidden="true"
                            >
                                <path
                                    d="M8 3.6 C6.6 2.7 4.6 2.4 2.6 3.1 V12.4 C4.6 11.6 6.6 11.9 8 12.9 C9.4 11.9 11.4 11.6 13.4 12.4 V3.1 C11.4 2.4 9.4 2.7 8 3.6 Z"
                                    fill="none"
                                    stroke="currentColor"
                                    stroke-width="1.4"
                                    stroke-linejoin="round"
                                />
                                <path
                                    class="book-page"
                                    d="M8 3.6 C6.6 2.7 4.6 2.4 2.6 3.1 V12.4 C4.6 11.6 6.6 11.9 8 12.9 Z"
                                    fill="currentColor"
                                    fill-opacity="0.5"
                                />
                            </svg>
                            <span class="now-title" id="now-book-title">
                                {bookShort}
                            </span>
                        </a>
                    )}
                </div>
            )}
        </div>
    </div>
</section>

<style>
    #about {
        border-bottom: 1px dotted var(--rule);
    }

    #about-inner {
        max-width: var(--max-w);
        margin: 0 auto;
        padding: 34.2px 0;
        display: grid;
        grid-template-columns: 99px 1fr;
        gap: 0 21.6px;
        align-items: start;
    }

    .section-label {
        font-size: 12.6px;
        letter-spacing: 0.12em;
        text-transform: uppercase;
        color: var(--blue-dim);
        padding-top: 3.6px;
    }

    #about-bio {
        font-size: 15.3px;
        line-height: 1.7;
        letter-spacing: 0.01em;
        color: var(--blue-mid);
        max-width: 576px;
    }

    /* Inline social links in the bio */
    .social {
        display: inline-flex;
        align-items: center;
        vertical-align: middle;
        gap: 5px;
        color: inherit;
        transition: color 160ms var(--ease-out);
    }

    .social:hover {
        color: var(--blue);
    }

    .social-icon {
        width: 1.1em;
        height: 1.1em;
        flex-shrink: 0;
    }

    .social-icon--x {
        fill: currentColor;
    }

    .social-icon--discord {
        fill: #5865f2;
    }

    /* Current read / last listen, kept quiet under the bio */
    #now-line {
        margin-top: 18px;
        display: flex;
        flex-wrap: wrap;
        gap: 7.2px 25.2px;
    }

    #now-line a {
        display: inline-flex;
        align-items: center;
        gap: 6.3px;
        max-width: 100%;
        font-family: var(--font-mono);
        font-size: 11.7px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--blue-dim);
        transition: color 160ms var(--ease-out);
    }

    #now-line a:hover {
        color: var(--blue);
    }

    .now-title {
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        max-width: 234px;
    }
    .now-icon {
        width: 27px;
        height: 27px;
        flex-shrink: 0;
    }

    .now-icon--book {
        color: var(--accent-blue);
    }

    .now-icon--vinyl {
        color: var(--accent-orange);
    }

    /* The grooves sweep around the disc */
    .vinyl-groove {
        transform-box: fill-box;
        transform-origin: center;
        animation: now-spin 2.8s linear infinite;
    }

    @keyframes now-spin {
        to {
            transform: rotate(1turn);
        }
    }

    /* A page lifts off the left side, swings over the spine, and returns */
    .book-page {
        transform-box: fill-box;
        transform-origin: 100% 50%;
        animation: now-page 3.4s ease-in-out infinite;
    }

    @keyframes now-page {
        0%,
        16% {
            transform: scaleX(1);
        }
        44%,
        60% {
            transform: scaleX(-1);
        }
        88%,
        100% {
            transform: scaleX(1);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .vinyl-groove,
        .book-page {
            animation: none;
        }
    }

    @media (max-width: 576px) {
        #about-inner {
            grid-template-columns: 1fr;
            gap: 14.4px;
        }

        #about-bio {
            font-size: 14.4px;
        }

        .now-title {
            max-width: 180px;
        }
    }
</style>

<script>
    // Swap build-time snapshots for live values. In dev the same paths are
    // served by src/middleware.ts; in production by the Pages Functions.
    (() => {
        const shorten = (s: string) =>
            s.length > 34 ? s.slice(0, 33).trimEnd() + "…" : s;

        async function refresh(
            endpoint: string,
            linkId: string,
            titleId: string,
            pick: (
                data: any,
            ) => { label: string; tip: string; url?: string | null } | null,
        ) {
            const link = document.getElementById(linkId);
            const title = document.getElementById(titleId);
            if (!link || !title) return;
            try {
                const res = await fetch(endpoint);
                if (!res.ok) return;
                const next = pick(await res.json());
                if (!next) return;
                if (next.label !== title.textContent)
                    title.textContent = next.label;
                if (link.title !== next.tip) link.title = next.tip;
                if (next.url && link.href !== next.url) link.href = next.url;
            } catch {
                /* keep the snapshot */
            }
        }

        // Last listen / now playing
        refresh("/api/now", "now-link", "now-title", (d) =>
            d?.track
                ? {
                      label: shorten(
                          d.track.split(/\s+[\u2014\u2013]\s+/)[0].trim(),
                      ),
                      tip: `${d.track} - ${d.artist}`,
                      url: d.url,
                  }
                : null,
        );

        // Current read
        refresh("/api/reading", "now-book-link", "now-book-title", (d) =>
            d?.title
                ? {
                      label: shorten(d.title.split(/\s*:\s*/)[0].trim()),
                      tip: `${d.title} - ${d.author}`,
                      url: d.url,
                  }
                : null,
        );
    })();
</script>
