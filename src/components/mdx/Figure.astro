---
// Zoomable figure for post content.
//
//   <Figure src="/figures/surang-client-server.svg" alt="…" caption="…" />
//
// Inline: hovering zooms in place and follows the pointer (a vanilla port of
// the Animate UI "Image Zoom" effect - spring feel, no React/Motion
// dependency); clicking opens the full-screen lightbox. Vector sources stay
// crisp at any size.
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

interface Props {
    src: string;
    alt: string;
    caption?: string;
    /** Optional cap on the inline width, e.g. "560px" for a portrait figure. */
    maxWidth?: string;
}

const { src, alt, caption, maxWidth } = Astro.props;

// Read the intrinsic size from the SVG's viewBox so the inline image reserves
// the right space (no layout shift) and the dialog knows its natural width.
let naturalW: number | null = null;
let naturalH: number | null = null;
try {
    const file = readFileSync(resolve(process.cwd(), "public", src.replace(/^\//, "")), "utf8");
    const vb = file.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
    if (vb) {
        naturalW = Math.round(Number(vb[1]));
        naturalH = Math.round(Number(vb[2]));
    }
} catch {
    /* keep the attributes off and let CSS size it */
}
---

<figure class="fig" style={maxWidth ? `--fig-max: ${maxWidth}` : undefined}>
    <div class="fig-frame">
        <img
            src={src}
            alt={alt}
            width={naturalW ?? undefined}
            height={naturalH ?? undefined}
            loading="lazy"
            decoding="async"
        />
        <button class="fig-zoom" type="button" data-zoom aria-label={`Zoom image: ${alt}`}>
            <svg viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
                <line x1="10.4" y1="10.4" x2="14.4" y2="14.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
                <line x1="5" y1="7" x2="9" y2="7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></line>
                <line x1="7" y1="5" x2="7" y2="9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></line>
            </svg>
            <span>Zoom</span>
        </button>
    </div>
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<dialog class="fig-dialog" data-dialog aria-label={alt}>
    <div class="fig-dialog-bar">
        <span class="fig-dialog-hint">Click image to toggle size · Esc to close</span>
        <button class="fig-close" type="button" data-close aria-label="Close">
            <span aria-hidden="true">✕</span>
        </button>
    </div>
    <div class="fig-dialog-body">
        <img
            src={src}
            alt={alt}
            width={naturalW ?? undefined}
            height={naturalH ?? undefined}
            style={naturalW ? `--fig-natural: ${naturalW}px` : undefined}
            data-full
        />
    </div>
</dialog>

<style>
    .fig {
        margin: 2em 0;
        max-width: var(--fig-max, 100%);
    }

    .fig-frame {
        position: relative;
        overflow: hidden;
        border: 1px dotted var(--rule);
        background: #08090c;
    }

    .fig-frame img {
        display: block;
        width: 100%;
        height: auto;
    }

    /* Hover zoom (Animate UI "Image Zoom" port): the transform itself is set
       from JS; a short transition gives the spring-like trailing feel. */
    @media (hover: hover) and (pointer: fine) {
        .fig-frame img {
            transform-origin: 0 0;
            transition: transform 140ms var(--ease-out);
            will-change: transform;
            cursor: zoom-in;
        }
    }

    .fig-zoom {
        position: absolute;
        top: 10px;
        right: 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        background: rgba(8, 9, 12, 0.82);
        border: 1px dotted var(--rule);
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--blue-dim);
        cursor: pointer;
        transition:
            color 160ms var(--ease-out),
            border-color 160ms var(--ease-out),
            transform 120ms var(--ease-out);
    }

    .fig-zoom:hover {
        color: var(--blue);
        border-color: var(--blue);
    }

    .fig-zoom:active {
        transform: scale(0.96);
    }

    .fig-zoom svg {
        width: 12px;
        height: 12px;
        display: block;
    }

    figcaption {
        margin-top: 10px;
        font-family: var(--font-mono);
        font-size: 12.6px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--blue-dim);
    }

    /* Lightbox - centered explicitly: the site's `* { margin: 0 }` reset
       removes the UA's auto margins that normally center a dialog. */
    .fig-dialog {
        position: fixed;
        inset: 0;
        margin: auto;
        width: fit-content;
        height: fit-content;
        max-width: 95vw;
        max-height: 92vh;
        padding: 0;
        border: 1px dotted var(--rule);
        background: #0a0b0e;
        color: var(--blue);
        opacity: 0;
        transform: scale(0.97);
        transition:
            opacity 180ms var(--ease-out),
            transform 220ms var(--ease-out),
            overlay 220ms allow-discrete,
            display 220ms allow-discrete;
    }

    .fig-dialog[open] {
        opacity: 1;
        transform: scale(1);
    }

    @starting-style {
        .fig-dialog[open] {
            opacity: 0;
            transform: scale(0.97);
        }
    }

    .fig-dialog::backdrop {
        background: rgba(8, 9, 12, 0);
        transition:
            background 220ms var(--ease-out),
            overlay 220ms allow-discrete,
            display 220ms allow-discrete;
    }

    .fig-dialog[open]::backdrop {
        background: rgba(8, 9, 12, 0.9);
    }

    @starting-style {
        .fig-dialog[open]::backdrop {
            background: rgba(8, 9, 12, 0);
        }
    }

    .fig-dialog-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 8px 12px;
        border-bottom: 1px dotted var(--rule);
    }

    .fig-dialog-hint {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--blue-dim);
    }

    .fig-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 26px;
        height: 26px;
        background: none;
        border: 1px dotted var(--rule);
        color: var(--blue-dim);
        font-size: 13px;
        cursor: pointer;
        transition:
            color 160ms var(--ease-out),
            border-color 160ms var(--ease-out),
            transform 120ms var(--ease-out);
    }

    .fig-close:hover {
        color: var(--blue);
        border-color: var(--blue);
    }

    .fig-close:active {
        transform: scale(0.94);
    }

    .fig-dialog-body {
        overflow: auto;
        overscroll-behavior: contain;
        max-height: calc(92vh - 44px);
    }

    .fig-dialog-body img {
        display: block;
        margin: auto;
        max-width: 92vw;
        max-height: calc(92vh - 68px);
        width: auto;
        height: auto;
        cursor: zoom-in;
    }

    .fig-dialog-body img.is-zoomed {
        max-width: none;
        max-height: none;
        width: var(--fig-natural, auto);
        cursor: zoom-out;
    }

    /* Keep the page still while the lightbox is open */
    :global(body:has(dialog[open])) {
        overflow: hidden;
    }

    @media (prefers-reduced-motion: reduce) {
        .fig-zoom,
        .fig-close,
        .fig-frame img {
            transition: none;
        }

        .fig-dialog,
        .fig-dialog::backdrop {
            transition: none;
        }
    }
</style>

<script>
    // One delegated set of handlers serves every figure on the page.
    const fine = matchMedia("(hover: hover) and (pointer: fine)");
    const reduce = matchMedia("(prefers-reduced-motion: reduce)");
    const HOVER_ZOOM = 2.6;

    // ---- hover zoom: scale up and follow the pointer (Animate UI port)
    let pending: PointerEvent | null = null;
    let raf = 0;

    function applyHoverZoom(event: PointerEvent) {
        const frame = (event.target as HTMLElement | null)?.closest?.(
            ".fig-frame",
        ) as HTMLElement | null;
        if (!frame) return;
        const img = frame.querySelector("img");
        if (!img) return;

        const r = frame.getBoundingClientRect();
        const x = Math.min(1, Math.max(0, (event.clientX - r.left) / r.width));
        const y = Math.min(1, Math.max(0, (event.clientY - r.top) / r.height));
        img.style.transform = `translate(${-(HOVER_ZOOM - 1) * x * r.width}px, ${-(HOVER_ZOOM - 1) * y * r.height}px) scale(${HOVER_ZOOM})`;
    }

    document.addEventListener("pointermove", (event) => {
        if (!fine.matches || reduce.matches) return;
        if (!(event.target as HTMLElement | null)?.closest?.(".fig-frame")) return;
        pending = event;
        if (raf) return;
        raf = requestAnimationFrame(() => {
            raf = 0;
            if (pending) applyHoverZoom(pending);
        });
    });

    document.addEventListener("pointerout", (event) => {
        const frame = (event.target as HTMLElement | null)?.closest?.(
            ".fig-frame",
        ) as HTMLElement | null;
        if (!frame) return;
        const to = event.relatedTarget as HTMLElement | null;
        if (to && frame.contains(to)) return; // still inside the figure
        const img = frame.querySelector("img");
        if (img) img.style.transform = "";
    });

    // ---- clicks
    document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        const openDialog = (figure: Element | null) =>
            (figure?.nextElementSibling as HTMLDialogElement | null)?.showModal();

        const zoomBtn = target.closest("[data-zoom]");
        if (zoomBtn) {
            openDialog(zoomBtn.closest("figure"));
            return;
        }

        // Clicking the inline image opens the lightbox too (the only zoom
        // affordance on touch, where hover doesn't exist)
        const inlineImg = target.closest(".fig-frame img");
        if (inlineImg) {
            openDialog(inlineImg.closest("figure"));
            return;
        }

        const closeBtn = target.closest("[data-close]");
        if (closeBtn) {
            closeBtn.closest("dialog")?.close();
            return;
        }

        // Click on the backdrop (the dialog element itself) closes it
        if (target instanceof HTMLDialogElement && target.hasAttribute("data-dialog")) {
            target.close();
            return;
        }

        // Click on the image inside the dialog toggles fit ↔ natural size
        const img = target.closest<HTMLElement>("dialog [data-full]");
        img?.classList.toggle("is-zoomed");
    });

    // Reset the size toggle whenever a lightbox closes (the close event
    // doesn't bubble, so listen in the capture phase).
    document.addEventListener(
        "close",
        (event) => {
            const dialog = event.target as HTMLElement | null;
            dialog?.querySelector?.("[data-full]")?.classList.remove("is-zoomed");
        },
        true,
    );
</script>
