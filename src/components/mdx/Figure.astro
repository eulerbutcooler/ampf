---
// Zoomable figure for post content.
//
//   <Figure src="/figures/surang-client-server.svg" alt="…" caption="…" />
//
// Inline: the image stays still (no hover zoom); a click or the Zoom button
// opens the full-screen lightbox, where the image can be dragged to pan,
// pinch- or wheel-zoomed toward the pointer, and double-clicked to toggle
// magnification. Vector sources stay crisp at any size.
import { readFileSync } from "node:fs";
import { resolve } from "node:path";

interface Props {
    src: string;
    alt: string;
    caption?: string;
    /** Optional cap on the inline width, e.g. "560px" for a portrait figure. */
    maxWidth?: string;
}

const { src, alt, caption, maxWidth } = Astro.props;

// Read the intrinsic size from the SVG's viewBox so the inline image reserves
// the right space (no layout shift).
let naturalW: number | null = null;
let naturalH: number | null = null;
try {
    const file = readFileSync(resolve(process.cwd(), "public", src.replace(/^\//, "")), "utf8");
    const vb = file.match(/viewBox="0 0 ([\d.]+) ([\d.]+)"/);
    if (vb) {
        naturalW = Math.round(Number(vb[1]));
        naturalH = Math.round(Number(vb[2]));
    }
} catch {
    /* keep the attributes off and let CSS size it */
}
---

<figure class="fig" style={maxWidth ? `--fig-max: ${maxWidth}` : undefined}>
    <div class="fig-frame">
        <img
            src={src}
            alt={alt}
            width={naturalW ?? undefined}
            height={naturalH ?? undefined}
            loading="lazy"
            decoding="async"
        />
        <button class="fig-zoom" type="button" data-zoom aria-label={`Zoom image: ${alt}`}>
            <svg viewBox="0 0 16 16" aria-hidden="true">
                <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.5"></circle>
                <line x1="10.4" y1="10.4" x2="14.4" y2="14.4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></line>
                <line x1="5" y1="7" x2="9" y2="7" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></line>
                <line x1="7" y1="5" x2="7" y2="9" stroke="currentColor" stroke-width="1.3" stroke-linecap="round"></line>
            </svg>
            <span>Zoom</span>
        </button>
    </div>
    {caption && <figcaption>{caption}</figcaption>}
</figure>

<dialog class="fig-dialog" data-dialog aria-label={alt}>
    <div class="fig-dialog-bar">
        <span class="fig-dialog-hint">Drag to pan · pinch or scroll to zoom · Esc to close</span>
        <button class="fig-close" type="button" data-close aria-label="Close">
            <span aria-hidden="true">✕</span>
        </button>
    </div>
    <div class="fig-stage">
        <img
            src={src}
            alt={alt}
            width={naturalW ?? undefined}
            height={naturalH ?? undefined}
            loading="lazy"
            decoding="async"
            draggable="false"
        />
    </div>
</dialog>

<style>
    .fig {
        margin: 2em 0;
        max-width: var(--fig-max, 100%);
    }

    .fig-frame {
        position: relative;
        overflow: hidden;
        border: 1px dotted var(--rule);
        background: #08090c;
    }

    .fig-frame img {
        display: block;
        width: 100%;
        height: auto;
    }

    /* The lightbox is the zoom affordance on fine pointers */
    @media (hover: hover) and (pointer: fine) {
        .fig-frame img {
            cursor: zoom-in;
        }
    }

    .fig-zoom {
        position: absolute;
        top: 10px;
        right: 10px;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 10px;
        background: rgba(8, 9, 12, 0.82);
        border: 1px dotted var(--rule);
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--blue-dim);
        cursor: pointer;
        transition:
            color 160ms var(--ease-out),
            border-color 160ms var(--ease-out),
            transform 120ms var(--ease-out);
    }

    .fig-zoom:hover {
        color: var(--blue);
        border-color: var(--blue);
    }

    .fig-zoom:active {
        transform: scale(0.96);
    }

    .fig-zoom svg {
        width: 12px;
        height: 12px;
        display: block;
    }

    figcaption {
        margin-top: 10px;
        font-family: var(--font-mono);
        font-size: 12.6px;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        color: var(--blue-dim);
    }

    /* Lightbox - centered explicitly: the site's `* { margin: 0 }` reset
       removes the UA's auto margins that normally center a dialog. */
    .fig-dialog {
        position: fixed;
        inset: 0;
        margin: auto;
        width: fit-content;
        height: fit-content;
        max-width: 96vw;
        max-height: 94vh;
        padding: 0;
        border: 1px dotted var(--rule);
        background: #0a0b0e;
        color: var(--blue);
        /* taps on the close button register without the double-tap delay */
        touch-action: manipulation;
        opacity: 0;
        transform: scale(0.97);
        transition:
            opacity 180ms var(--ease-out),
            transform 220ms var(--ease-out),
            overlay 220ms allow-discrete,
            display 220ms allow-discrete;
    }

    .fig-dialog[open] {
        opacity: 1;
        transform: scale(1);
    }

    @starting-style {
        .fig-dialog[open] {
            opacity: 0;
            transform: scale(0.97);
        }
    }

    .fig-dialog::backdrop {
        background: rgba(8, 9, 12, 0);
        transition:
            background 220ms var(--ease-out),
            overlay 220ms allow-discrete,
            display 220ms allow-discrete;
    }

    .fig-dialog[open]::backdrop {
        background: rgba(8, 9, 12, 0.9);
    }

    @starting-style {
        .fig-dialog[open]::backdrop {
            background: rgba(8, 9, 12, 0);
        }
    }

    .fig-dialog-bar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 8px 12px;
        border-bottom: 1px dotted var(--rule);
    }

    .fig-dialog-hint {
        font-family: var(--font-mono);
        font-size: 12px;
        letter-spacing: 0.08em;
        text-transform: uppercase;
        color: var(--blue-dim);
    }

    .fig-close {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        flex: none;
        width: 26px;
        height: 26px;
        background: none;
        border: 1px dotted var(--rule);
        color: var(--blue-dim);
        font-size: 13px;
        cursor: pointer;
        transition:
            color 160ms var(--ease-out),
            border-color 160ms var(--ease-out),
            transform 120ms var(--ease-out);
    }

    .fig-close:hover {
        color: var(--blue);
        border-color: var(--blue);
    }

    .fig-close:active {
        transform: scale(0.94);
    }

    /* A viewport onto the image: pan and pinch happen here, so the browser's
       own touch gestures must be suppressed inside it. */
    .fig-stage {
        position: relative;
        overflow: hidden;
        width: calc(94vw - 2px);
        height: calc(92vh - 46px - 2px);
        touch-action: none;
        cursor: grab;
        user-select: none;
        -webkit-user-select: none;
    }

    .fig-stage.is-grabbing {
        cursor: grabbing;
    }

    .fig-stage img {
        position: absolute;
        left: 0;
        top: 0;
        display: block;
        transform-origin: 0 0;
        -webkit-user-drag: none;
    }

    /* Keep the page still while the lightbox is open */
    :global(body:has(dialog[open])) {
        overflow: hidden;
    }

    @media (prefers-reduced-motion: reduce) {
        .fig-zoom,
        .fig-close {
            transition: none;
        }

        .fig-dialog,
        .fig-dialog::backdrop {
            transition: none;
        }
    }
</style>

<script>
    // One delegated opener/closer serves every figure on the page; each
    // lightbox gets its own pan/pinch controller the first time it opens.
    const MIN_SCALE = 1;
    const MAX_SCALE = 6;

    const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));

    const controllers = new WeakMap<HTMLDialogElement, () => void>();

    function setup(dialog: HTMLDialogElement) {
        if (controllers.has(dialog)) return;
        const stage = dialog.querySelector<HTMLElement>(".fig-stage");
        const img = stage?.querySelector<HTMLElement>("img");
        if (!stage || !img) return;

        let scale = 1;
        let tx = 0;
        let ty = 0;
        let baseW = 0;
        let baseH = 0;
        const pointers = new Map<number, { x: number; y: number }>();
        let pinch: { d0: number; s0: number; tx0: number; ty0: number; mx0: number; my0: number } | null =
            null;

        const apply = () => {
            img.style.transform = `translate(${tx}px, ${ty}px) scale(${scale})`;
        };

        // The translation includes the centring offset, so the image spans
        // [tx, tx + baseW*scale] in stage coordinates.
        const clampT = () => {
            const overX = baseW * scale - stage.clientWidth;
            const overY = baseH * scale - stage.clientHeight;
            tx = overX > 0
                ? clamp(tx, stage.clientWidth - baseW * scale, 0)
                : (stage.clientWidth - baseW * scale) / 2;
            ty = overY > 0
                ? clamp(ty, stage.clientHeight - baseH * scale, 0)
                : (stage.clientHeight - baseH * scale) / 2;
        };

        // Contain the image in the stage at scale 1 and centre it.
        const fit = () => {
            const w = stage.clientWidth;
            const h = stage.clientHeight;
            if (!w || !h) return false;
            const nw = img.naturalWidth || Number(img.getAttribute("width")) || 0;
            const nh = img.naturalHeight || Number(img.getAttribute("height")) || 0;
            if (nw && nh) {
                const contain = Math.min(w / nw, h / nh);
                baseW = nw * contain;
                baseH = nh * contain;
            } else {
                baseW = w;
                baseH = h;
            }
            img.style.width = `${baseW}px`;
            img.style.height = `${baseH}px`;
            scale = 1;
            clampT();
            pinch = null;
            apply();
            return true;
        };

        const stagePoint = (x: number, y: number) => {
            const r = stage.getBoundingClientRect();
            return { x: x - r.left, y: y - r.top };
        };

        // Scale about a fixed stage point (the cursor / pinch midpoint).
        const zoomTo = (next: number, px: number, py: number) => {
            const target = clamp(next, MIN_SCALE, MAX_SCALE);
            const k = target / scale;
            tx = px - (px - tx) * k;
            ty = py - (py - ty) * k;
            scale = target;
            clampT();
            apply();
        };

        stage.addEventListener("wheel", (event: WheelEvent) => {
            event.preventDefault();
            const p = stagePoint(event.clientX, event.clientY);
            zoomTo(scale * Math.exp(-event.deltaY * 0.0015), p.x, p.y);
        }, { passive: false });

        stage.addEventListener("dblclick", (event) => {
            const p = stagePoint(event.clientX, event.clientY);
            zoomTo(scale > 1.05 ? MIN_SCALE : 2.5, p.x, p.y);
        });

        stage.addEventListener("pointerdown", (event: PointerEvent) => {
            try {
                stage.setPointerCapture(event.pointerId);
            } catch {
                /* synthetic events cannot be captured */
            }
            pointers.set(event.pointerId, { x: event.clientX, y: event.clientY });
            stage.classList.add("is-grabbing");
            if (pointers.size === 2) {
                const [a, b] = [...pointers.values()];
                const mid = stagePoint((a.x + b.x) / 2, (a.y + b.y) / 2);
                pinch = {
                    d0: Math.hypot(b.x - a.x, b.y - a.y) || 1,
                    s0: scale,
                    tx0: tx,
                    ty0: ty,
                    mx0: mid.x,
                    my0: mid.y,
                };
            }
        });

        stage.addEventListener("pointermove", (event: PointerEvent) => {
            const prev = pointers.get(event.pointerId);
            if (!prev) return;
            const dx = event.clientX - prev.x;
            const dy = event.clientY - prev.y;
            prev.x = event.clientX;
            prev.y = event.clientY;

            if (pointers.size >= 2 && pinch) {
                const [a, b] = [...pointers.values()];
                const d = Math.hypot(b.x - a.x, b.y - a.y) || 1;
                const mid = stagePoint((a.x + b.x) / 2, (a.y + b.y) / 2);
                const target = clamp(pinch.s0 * (d / pinch.d0), MIN_SCALE, MAX_SCALE);
                const k = target / pinch.s0;
                tx = mid.x - (pinch.mx0 - pinch.tx0) * k;
                ty = mid.y - (pinch.my0 - pinch.ty0) * k;
                scale = target;
                clampT();
                apply();
                return;
            }

            tx += dx;
            ty += dy;
            clampT();
            apply();
        });

        const release = (event: PointerEvent) => {
            pointers.delete(event.pointerId);
            if (pointers.size < 2) pinch = null;
            if (pointers.size === 0) stage.classList.remove("is-grabbing");
        };
        stage.addEventListener("pointerup", release);
        stage.addEventListener("pointercancel", release);

        // Re-contain on viewport changes and reset the view when closed.
        new ResizeObserver(() => {
            if (dialog.open) fit();
        }).observe(stage);
        dialog.addEventListener("close", () => fit());

        controllers.set(dialog, fit);
    }

    document.addEventListener("click", (event) => {
        const target = event.target as HTMLElement | null;
        if (!target) return;

        const openDialog = (figure: Element | null) => {
            const dlg = figure?.nextElementSibling as HTMLDialogElement | null;
            if (!dlg) return;
            setup(dlg);
            const refit = controllers.get(dlg);
            dlg.showModal();
            requestAnimationFrame(() => refit?.());
        };

        const zoomBtn = target.closest("[data-zoom]");
        if (zoomBtn) {
            openDialog(zoomBtn.closest("figure"));
            return;
        }

        // A click on the inline image is a second path into the lightbox
        const inlineImg = target.closest(".fig-frame img");
        if (inlineImg) {
            openDialog(inlineImg.closest("figure"));
            return;
        }

        const closeBtn = target.closest("[data-close]");
        if (closeBtn) {
            closeBtn.closest("dialog")?.close();
            return;
        }

        // Click on the backdrop (the dialog element itself) closes it
        if (target instanceof HTMLDialogElement && target.hasAttribute("data-dialog")) {
            target.close();
            return;
        }
    });
</script>
