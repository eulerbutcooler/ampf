---
const path = Astro.url.pathname;
const isBlogs = path === "/blogs" || path.startsWith("/blog/");
const isProjects = path === "/projects";
---

<nav id="navbar">
  <a href="/" id="nav-monogram" aria-label="Home">AM</a>

  <div id="nav-links">
    <a href="/blogs" aria-current={isBlogs ? "page" : undefined}>Blogs</a>
    <a href="/projects" aria-current={isProjects ? "page" : undefined}>Projects</a>
    <a href="/resume.pdf" target="_blank" rel="noopener">Resume</a>
    <a href="mailto:eulerbutcooler@gmail.com">Email</a>
    <a href="https://github.com/eulerbutcooler" target="_blank" rel="noopener">GitHub</a>
    <a href="https://linkedin.com/in/amaan-pathan" target="_blank" rel="noopener">LinkedIn</a>
  </div>
</nav>

<style>
  #navbar {
    display: flex;
    align-items: center;
    gap: 28.8px;
    padding: 16.2px 0;
    border-bottom: 1px dotted var(--rule);
    width: 100%;
    max-width: var(--content-w, var(--max-w));
    margin: 0 auto;
  }

  #nav-monogram {
    font-family: var(--font-doto);
    font-variation-settings: "ROND" 0;
    font-size: 18.9px;
    font-weight: 700;
    letter-spacing: 0.1em;
    color: var(--blue);
    flex-shrink: 0;
    margin-right: auto;
    transition: opacity 150ms var(--ease-out);
  }

  #nav-monogram:hover {
    opacity: 0.7;
  }

  #nav-links {
    display: flex;
    align-items: center;
    gap: 25.2px;
  }

  #nav-links a {
    position: relative;
    font-size: 14.4px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--blue-dim);
    transition: color 160ms var(--ease-out);
  }

  #nav-links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -6.3px;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms var(--ease-out);
  }

  #nav-links a:hover,
  #nav-links a[aria-current] {
    color: var(--blue);
  }

  #nav-links a:hover::after,
  #nav-links a[aria-current]::after {
    transform: scaleX(1);
  }

  @media (max-width: 576px) {
    #nav-links { gap: 18px; }
    #nav-links a:not([href="/blogs"]):not([href="/projects"]):not([href="/resume.pdf"]) { display: none; }
  }
</style>
