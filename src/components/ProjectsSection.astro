---
import ProjectCard from "./ProjectCard.astro";
import { projects } from "../data/projects";

const featured = projects.filter((p) => p.featured);
---

<section id="projects">
  <div id="projects-inner">
    <span class="section-label">[Work]</span>

    <div id="projects-list">
      {featured.map((p) => (
        <ProjectCard
          index={p.index}
          title={p.title}
          description={p.description}
          stack={p.stack}
          github={p.github}
          live={p.live}
          year={p.year}
        />
      ))}

      <a href="/projects" class="all-row">
        <span class="all-text">All projects →</span>
      </a>
    </div>
  </div>
</section>

<style>
  #projects {
    border-bottom: 1px dotted var(--rule);
  }

  #projects-inner {
    max-width: var(--max-w);
    margin: 0 auto;
    padding: 34.2px 0;
    display: grid;
    grid-template-columns: 99px 1fr;
    gap: 0 21.6px;
    align-items: start;
  }

  .section-label {
    font-size: 12.6px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--blue-dim);
    padding-top: 18px;
  }

  #projects-list {
    display: flex;
    flex-direction: column;
  }

  #projects-list > :global(.project-row:first-child) {
    border-top: 1px dotted var(--rule);
  }

  #projects-list > :global(.project-row:last-child) {
    border-bottom: none;
  }

  .all-row {
    display: block;
    padding: 15.3px 18px;
    text-decoration: none;
    color: var(--blue-dim);
    transition:
      background-color 140ms var(--ease-out),
      color 160ms var(--ease-out);
    border-top: 1px dotted var(--rule);
  }

  .all-row:hover {
    background: var(--blue-subtle);
    color: var(--blue);
  }

  .all-row:active {
    background: var(--border);
  }

  .all-text {
    font-family: var(--font-mono);
    font-size: 11.7px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  @media (max-width: 576px) {
    #projects-inner {
      grid-template-columns: 1fr;
      gap: 14.4px;
    }

    .section-label {
      padding-top: 0;
    }
  }
</style>
